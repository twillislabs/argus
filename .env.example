# Copy to .env and fill in. Generate random values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use URL-safe characters for POSTGRES_PASSWORD (it is part of a URL).

POSTGRES_PASSWORD=
ARGUS_SECRET_KEY=

# Port the web container listens on.
ARGUS_HTTP_PORT=8080

# Cookies are Secure by default, which needs HTTPS. Set to false only for
# plain-HTTP use on localhost or a trusted LAN while testing.
ARGUS_COOKIE_SECURE=true

ARGUS_LOG_LEVEL=INFO

# Collectors the worker runs (comma list): usgs, gdelt, rss, firms.
ARGUS_COLLECTORS=usgs,gdelt,rss,firms

# Military aircraft from adsb.lol (worldwide, every 15 s). Civil aircraft
# are fetched for the area in view. Set false to turn aircraft off.
ARGUS_AIR_ENABLED=true

# NASA FIRMS fire detections need a free MAP_KEY:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
ARGUS_FIRMS_MAP_KEY=

# Optional fixed first-run token for automated installs. Leave empty to get
# a random one in the API log.
ARGUS_SETUP_TOKEN=
