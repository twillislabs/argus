# Copy to .env and fill in. Generate random values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use URL-safe characters for POSTGRES_PASSWORD (it is part of a URL).

POSTGRES_PASSWORD=
ARGUS_SECRET_KEY=

# Port the web container listens on.
ARGUS_HTTP_PORT=8080

# Cookies are Secure by default, which needs HTTPS. Set to false only for
# plain-HTTP use on localhost or a trusted LAN while testing.
ARGUS_COOKIE_SECURE=true

# HTTPS with a self-signed certificate until a proxy with a real one is
# in front: ARGUS_TLS=self-signed, the names and IPs people use, and the
# host port. Leave ARGUS_TLS empty for plain HTTP only.
ARGUS_TLS=
ARGUS_TLS_NAMES=localhost
# Set (for example 8443) when ARGUS_TLS is on; http:// then redirects
# there unless ARGUS_TLS_REDIRECT=false.
ARGUS_HTTPS_PORT=
ARGUS_TLS_REDIRECT=true

# Behind a reverse proxy (nginx, Caddy, Cloudflare): the proxies' IPs or
# ranges as the web container sees them (comma list), so sign-in limits
# and the audit log see visitors, not the proxy. Empty trusts nobody.
# A proxy on the same Docker host arrives through the bridge: 172.16.0.0/12.
ARGUS_TRUSTED_PROXIES=
# Header the proxies put the visitor in: X-Forwarded-For, or
# CF-Connecting-IP when Cloudflare connects to Argus directly.
ARGUS_REAL_IP_HEADER=X-Forwarded-For

ARGUS_LOG_LEVEL=INFO

# Collectors the worker runs. Leave unset to run them all (new ones then
# start after an update), or give a comma list: usgs, gdelt, rss, firms,
# gdacs, eonet, tsunami, nga, faa_tfr, sigmet, czib, nws, spc, fema, nifc.
# ARGUS_COLLECTORS=

# Military aircraft from adsb.lol (worldwide, every 15 s). Civil aircraft
# are fetched for the area in view. Set false to turn aircraft off.
ARGUS_AIR_ENABLED=true

# NASA FIRMS fire detections need a free MAP_KEY:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
ARGUS_FIRMS_MAP_KEY=

# Optional fixed first-run token for automated installs. Leave empty to get
# a random one in the API log.
ARGUS_SETUP_TOKEN=
